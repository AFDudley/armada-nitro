pragma solidity 0.8.17;

import {Script, console2} from 'forge-std/Script.sol';
import {Vm} from 'forge-std/Vm.sol';
import {IERC20} from '@openzeppelin/contracts/token/ERC20/IERC20.sol';
import {PrivacyPool} from 'armada/privacy-pool/PrivacyPool.sol';
import {ArmadaNitroAdjudicator} from 'src/ArmadaNitroAdjudicator.sol';
import {INitroTypes} from 'src/nitro/interfaces/INitroTypes.sol';
import {CommitmentPreimage} from 'src/armada/IArmadaPool.sol';
import {ChannelStates} from '../test/helpers/ChannelStates.sol';
import {IHubCustodian} from '../test/helpers/IHubCustodian.sol';
import {ArmadaNotes} from '../test/helpers/ArmadaNotes.sol';
import {NitroUtils} from 'src/nitro/libraries/NitroUtils.sol';

/// @dev Circle's FiatToken mint, guarded by the minter role the funding module configures for
/// the deployer (env/reconciler/modules/funding.py). Selector-only, same as
/// FixturenetScenario.s.sol -- the real return type (bool) is irrelevant to a `call` we don't
/// decode.
interface IMintableUSDC {
    function mint(address to, uint256 amount) external;
}

/**
 * @notice armada-custodian-e2e: a real 2-of-3 FROST group -- generated by `tools/frost-signer`'s
 * deterministic trusted-dealer keygen, read from `SHARES_DIR` -- authorizes a delegate on a
 * freshly deployed HubCustodian, and that delegate's signature closes a channel funded by a
 * real-proof deposit (env/gates/nitro-e2e/prepare.ts, bound to this custodian via
 * `HUB_CUSTODIAN_OVERRIDE`). E14d then schedules the delegate's revocation, rotates the group
 * key to a second FROST group, and runs four discrimination checks that rule out weaker causes
 * for each rejection (a single signer, a stale nonce, the revoked delegate, the wrong hash).
 *
 * A fresh custodian is deployed here (rather than reusing the fixturenet's shared one) because
 * that shared instance's group key is `FixturenetScenario.s.sol`'s well-known `HUB_GROUP_SCALAR`
 * (a single party, simulated by `FrostTestSigner` for `armada-nitro-e2e`) -- there are no real
 * FROST shares for it. This script's custodian reuses the shared adjudicator, ConsensusApp,
 * PrivacyPool and USDC from the manifest; only the custodian is this gate's own, and it is never
 * written back into the manifest, so `armada-nitro-e2e` is unaffected.
 *
 * Every group-authorized call (`_hubExecute`/`_hubExecuteShares`) signs `operationHash` with real
 * FROST shares via `frost-signer sign --format json` through `vm.ffi` (forge script must run with
 * `--ffi`) -- a real threshold signature, not a simulated one.
 *
 * Each phase is a separate `forge script --sig` call:
 *   deployAndAuthorize  deploy the custodian under the FROST group key; signers {1,3} authorize
 *                       the delegate through `execute`; stock the custodian.
 *   cooperativeClose    fund the channel (real-proof deposit + custodian executes), then the
 *                       delegate + user cooperatively close it, shielding the payout.
 *   verify              read chain state and Shield logs; revert on any mismatch.
 *   revoke              signers {2,3} schedule `revokeDelegate` (E14d step 3).
 *   rotate              signers {1,2} `rotateGroupKey` to `NEW_SHARES_DIR`'s group (E14d step 4).
 *   discriminate        the four discrimination checks plus step 3/4's rejection evidence, run
 *                       as non-broadcast calls so a rejection surfaces as this call's own revert
 *                       data; writes DISCRIMINATION_FILE.
 *
 * Environment: DELEGATE_KEY, REVOCATION_DELAY, CHALLENGE_DURATION, SHARES_DIR, NEW_SHARES_DIR,
 * FROST_SIGNER, MANIFEST_PATH (default /env/manifest.json), DEPOSITS_PATH (default
 * /env/custodian-e2e/deposits.json), KEYS_DIR (default /env).
 */
contract CustodianFrostScenario is Script {
    bytes32 internal constant USER_PAYOUT_NPK = bytes32(uint256(0x3333));
    uint256 internal constant HUB_STOCK = 1_000e6;
    uint256 internal constant HUB_FUNDS = 100e6;

    uint256 internal constant COOPERATIVE_USER = 130e6;
    uint256 internal constant COOPERATIVE_HUB = 70e6;

    string internal constant CUSTODIAN_FILE = 'deployments/custodian-e2e-custodian-address';
    string internal constant START_BLOCK_FILE = 'deployments/custodian-e2e-start-block';
    string internal constant DISCRIMINATION_FILE = 'deployments/custodian-e2e-discrimination.json';

    struct Ctx {
        PrivacyPool privacyPool;
        IERC20 usdc;
        ArmadaNitroAdjudicator adjudicator;
        address consensusApp;
        address user;
        uint256 deployerKey;
        uint256 userKey;
        uint256 delegateKey;
        uint48 challengeDuration;
        string sharesDir;
        string frostSigner;
    }

    struct Deposit {
        bytes32 channelId;
        uint64 channelNonce;
        uint256 amount;
        bytes txCalldata;
    }

    function deployAndAuthorize() external {
        Ctx memory c = _ctx();
        string memory pubkeyJson = vm.readFile(string.concat(c.sharesDir, '/group-pubkey.json'));
        uint256 groupKeyX = vm.parseJsonUint(pubkeyJson, '.x');
        uint256 groupKeyY = vm.parseJsonUint(pubkeyJson, '.y');
        uint256 revocationDelay = vm.envOr('REVOCATION_DELAY', uint256(60));

        vm.broadcast(c.deployerKey);
        address custodian = deployCode(
            'HubCustodian.sol:HubCustodian',
            abi.encode(groupKeyX, groupKeyY, revocationDelay)
        );

        vm.createDir('deployments', true);
        vm.writeFile(CUSTODIAN_FILE, vm.toString(custodian));
        vm.writeFile(START_BLOCK_FILE, vm.toString(block.number));

        address delegate = vm.addr(c.delegateKey);
        _hubExecute(c, custodian, custodian, abi.encodeCall(IHubCustodian.authorizeDelegate, (delegate)));

        vm.broadcast(c.deployerKey);
        IMintableUSDC(address(c.usdc)).mint(custodian, HUB_STOCK);

        console2.log('custodian deployed at', custodian);
        console2.log('delegate', delegate);
        console2.log('isActiveDelegate', IHubCustodian(custodian).isActiveDelegate(delegate));
    }

    function cooperativeClose() external {
        Ctx memory c = _ctx();
        address custodian = _readCustodian();
        Deposit memory d = _deposit();
        _fund(c, custodian, d);

        INitroTypes.FixedPart memory fp = _fixedPart(c, custodian, d.channelNonce);
        INitroTypes.VariablePart memory finalState = _state(c, custodian, 7, true, COOPERATIVE_USER, COOPERATIVE_HUB);
        INitroTypes.SignedVariablePart memory signedFinal = ChannelStates.signedByBoth(
            c.userKey,
            c.delegateKey,
            fp,
            finalState
        );
        vm.broadcast(c.deployerKey);
        c.adjudicator.concludeAndTransferAllAssets(fp, signedFinal);
    }

    /// @dev Step 3 (E14d): signers {2,3} schedule `revokeDelegate` through `execute`
    /// (FROST-signed) -- the delegate stays valid until the revocation delay elapses.
    function revoke() external {
        Ctx memory c = _ctx();
        address custodian = _readCustodian();
        address delegate = vm.addr(c.delegateKey);
        _hubExecuteShares(c, custodian, custodian, abi.encodeCall(IHubCustodian.revokeDelegate, (delegate)), 2, 3);
    }

    /// @dev Step 4 (E14d): signers {1,2} rotate the group key to a new FROST group (the
    /// `--seed`-generated group, a different keypair from the default). A signature made by
    /// the old group's shares then fails `execute` (InvalidGroupSignature).
    function rotate() external {
        Ctx memory c = _ctx();
        address custodian = _readCustodian();
        string memory newDir = vm.envOr('NEW_SHARES_DIR', string('/env/custodian-shares-new'));
        string memory newPubkeyJson = vm.readFile(string.concat(newDir, '/group-pubkey.json'));
        uint256 newX = vm.parseJsonUint(newPubkeyJson, '.x');
        uint256 newY = vm.parseJsonUint(newPubkeyJson, '.y');
        _hubExecuteShares(c, custodian, custodian, abi.encodeCall(IHubCustodian.rotateGroupKey, (newX, newY)), 1, 2);
    }

    /// @dev E14d discrimination (a)-(d) plus step 3/4's rejection evidence, run as non-broadcast
    /// calls against the chain's current state (after `revoke()`, the revocation delay, and
    /// `rotate()`). Each check signs with real FROST shares via `frost-signer sign --format
    /// json` through `vm.ffi`, then submits the call directly (not through `vm.broadcast`) so a
    /// rejection surfaces as this call's own revert data -- what `execute` would do on a real
    /// `cast send`, without spending gas on a doomed transaction. Writes one JSON object to
    /// DISCRIMINATION_FILE for the job script to read.
    function discriminate() external {
        Ctx memory c = _ctx();
        address custodian = _readCustodian();
        (bool oldGroupOk, bytes4 oldGroupSelector) = _checkOldGroupRejected(c, custodian);
        (bool replayOk, bytes4 replaySelector) = _checkReplayRejected(c, custodian);
        (bool delegateRejected, bytes4 isValidSigResult) = _checkRevokedDelegateRejected(c, custodian);
        (bool wrongHashOk, bytes4 wrongHashSelector) = _checkWrongHashRejected(c, custodian);

        string memory json = string.concat(
            string.concat(
                '{"step4_old_group_signature_rejected":', oldGroupOk ? 'false' : 'true',
                ',"step4_old_group_signature_rejected_evidence":"', vm.toString(abi.encodePacked(oldGroupSelector)),
                '","discrimination_a_single_signer_rejected":', oldGroupOk ? 'false' : 'true',
                ',"discrimination_a_single_signer_rejected_evidence":"', vm.toString(abi.encodePacked(oldGroupSelector)),
                '","discrimination_b_replay_rejected":', replayOk ? 'false' : 'true'
            ),
            string.concat(
                ',"discrimination_b_replay_rejected_evidence":"', vm.toString(abi.encodePacked(replaySelector)),
                '","discrimination_c_revoked_delegate_rejected":', delegateRejected ? 'true' : 'false',
                ',"discrimination_c_revoked_delegate_rejected_evidence":"', vm.toString(abi.encodePacked(isValidSigResult)),
                '","discrimination_d_wrong_hash_rejected":', wrongHashOk ? 'false' : 'true',
                ',"discrimination_d_wrong_hash_rejected_evidence":"', vm.toString(abi.encodePacked(wrongHashSelector)), '"}'
            )
        );
        vm.writeFile(DISCRIMINATION_FILE, json);
    }

    /// @dev step4 / discrimination (a)-ii: a VALID signature made by the OLD (now foreign)
    /// group over the CURRENT operation is rejected by `execute` -- the group key has moved to
    /// the new group, so the old group's otherwise-correct signature no longer authorizes
    /// anything.
    function _checkOldGroupRejected(Ctx memory c, address custodian) internal returns (bool ok, bytes4 selector) {
        bytes memory noopData = bytes('');
        bytes32 message = IHubCustodian(custodian).operationHash(
            IHubCustodian(custodian).nonce(), custodian, 0, noopData
        );
        return _rawExecute(custodian, custodian, noopData, _signWith(c, c.sharesDir, 1, 3, message));
    }

    /// @dev discrimination (b): replay -- the CURRENT (correct) group signs the hash for a
    /// STALE nonce (0, step 1's authorizeDelegate operation); `execute` recomputes the hash
    /// with the current nonce, which no longer matches what was signed.
    function _checkReplayRejected(Ctx memory c, address custodian) internal returns (bool ok, bytes4 selector) {
        string memory newDir = vm.envOr('NEW_SHARES_DIR', string('/env/custodian-shares-new'));
        bytes memory authData = abi.encodeCall(IHubCustodian.authorizeDelegate, (vm.addr(c.delegateKey)));
        bytes32 staleMsg = IHubCustodian(custodian).operationHash(0, custodian, 0, authData);
        return _rawExecute(custodian, custodian, authData, _signWith(c, newDir, 1, 2, staleMsg));
    }

    /// @dev discrimination (c): a state signed by the revoked delegate, after the delay, is
    /// rejected by `isValidSignature` (the EIP-1271 "invalid" sentinel, not its magic value).
    function _checkRevokedDelegateRejected(
        Ctx memory c,
        address custodian
    ) internal view returns (bool rejected, bytes4 result) {
        INitroTypes.FixedPart memory fp = _fixedPart(c, custodian, 999);
        INitroTypes.VariablePart memory vp = _state(c, custodian, 7, true, COOPERATIVE_USER, COOPERATIVE_HUB);
        bytes32 stateHash = NitroUtils.hashState(fp, vp);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(c.delegateKey, stateHash);
        result = IHubCustodian(custodian).isValidSignature(stateHash, abi.encodePacked(r, s, v));
        rejected = result == bytes4(0xffffffff);
    }

    /// @dev discrimination (d): the CURRENT (correct) group signs the hash for a DIFFERENT
    /// operation (`wrongData`) at the current nonce; `execute` is called with a no-op instead,
    /// so the recomputed hash does not match what was signed.
    function _checkWrongHashRejected(Ctx memory c, address custodian) internal returns (bool ok, bytes4 selector) {
        string memory newDir = vm.envOr('NEW_SHARES_DIR', string('/env/custodian-shares-new'));
        uint256 currentNonce = IHubCustodian(custodian).nonce();
        bytes memory wrongData = abi.encodeCall(IHubCustodian.authorizeDelegate, (address(0xdEaD)));
        bytes32 wrongMsg = IHubCustodian(custodian).operationHash(currentNonce, custodian, 0, wrongData);
        return _rawExecute(custodian, custodian, bytes(''), _signWith(c, newDir, 1, 2, wrongMsg));
    }

    /// @dev Signs `message` with real FROST shares {a,b} from `dir` (`frost-signer sign
    /// --format json` via `vm.ffi`) and returns the parsed `GroupSignature`.
    function _signWith(
        Ctx memory c,
        string memory dir,
        uint8 a,
        uint8 b,
        bytes32 message
    ) internal returns (IHubCustodian.GroupSignature memory) {
        string[] memory cmd = new string[](9);
        cmd[0] = c.frostSigner;
        cmd[1] = 'sign';
        cmd[2] = '--shares';
        cmd[3] = string.concat(dir, '/share-', vm.toString(uint256(a)));
        cmd[4] = string.concat(dir, '/share-', vm.toString(uint256(b)));
        cmd[5] = '--message';
        cmd[6] = vm.toString(message);
        cmd[7] = '--format';
        cmd[8] = 'json';
        string memory json = string(vm.ffi(cmd));
        return IHubCustodian.GroupSignature({
            commitmentX: vm.parseJsonUint(json, '.commitmentX'),
            commitmentY: vm.parseJsonUint(json, '.commitmentY'),
            z: vm.parseJsonUint(json, '.z')
        });
    }

    /// @dev Calls `execute` directly (not through `vm.broadcast`) so a rejection surfaces as
    /// this call's own revert data; returns whether it succeeded and the observed 4-byte
    /// selector (0 on success, or on a revert with no reason data).
    function _rawExecute(
        address custodian,
        address target,
        bytes memory data,
        IHubCustodian.GroupSignature memory sig
    ) internal returns (bool ok, bytes4 selector) {
        bytes memory ret;
        (ok, ret) = custodian.call(abi.encodeCall(IHubCustodian.execute, (target, 0, data, sig)));
        if (!ok && ret.length >= 4) {
            selector = bytes4(ret);
        }
    }

    /// @dev c7: the Shield log's payout note value equals the closed state's user allocation
    /// net of the pool's live `shieldFee()`.
    function verify() external view {
        Ctx memory c = _ctx();
        address custodian = _readCustodian();
        Deposit memory d = _deposit();
        require(c.adjudicator.holdings(address(c.usdc), d.channelId) == 0, 'channel not emptied');

        uint256 startBlock = vm.parseUint(vm.readFile(START_BLOCK_FILE));
        bytes32[] memory topics = new bytes32[](1);
        topics[0] = ArmadaNotes.SHIELD_EVENT;
        Vm.EthGetLogs[] memory logs = vm.eth_getLogs(startBlock, block.number, address(c.privacyPool), topics);
        bool paid;
        for (uint256 i = 0; i < logs.length; i++) {
            (CommitmentPreimage[] memory notes, ) = ArmadaNotes.decodeShield(logs[i].data);
            for (uint256 j = 0; j < notes.length; j++) {
                if (notes[j].npk == USER_PAYOUT_NPK && notes[j].value == _netOfShieldFee(c, COOPERATIVE_USER)) {
                    paid = true;
                }
            }
        }
        require(paid, 'no shielded note for the cooperative close');
        console2.log('verified: cooperative close paid the user by shielding a note');
    }

    // ---------------------------------------------------------------- helpers

    /// @dev User funds from the real-proof note; the hub tops up from the custodian (each a
    /// FROST-signed `execute`).
    function _fund(Ctx memory c, address custodian, Deposit memory d) internal {
        vm.broadcast(c.userKey);
        (bool ok, bytes memory ret) = address(c.adjudicator).call(d.txCalldata);
        if (!ok) {
            assembly ('memory-safe') {
                revert(add(ret, 0x20), mload(ret))
            }
        }

        _hubExecute(
            c,
            custodian,
            address(c.usdc),
            abi.encodeWithSignature('approve(address,uint256)', address(c.adjudicator), HUB_FUNDS)
        );
        _hubExecute(
            c,
            custodian,
            address(c.adjudicator),
            abi.encodeCall(c.adjudicator.deposit, (address(c.usdc), d.channelId, d.amount, HUB_FUNDS))
        );
    }

    /// @dev Signs `operationHash(nonce, target, 0, data)` with real FROST shares {a,b} --
    /// the two signer indices (any two of 1,2,3) -- via `frost-signer sign --format json`
    /// through `vm.ffi`, then broadcasts the group-authorized `execute`.
    function _hubExecuteShares(Ctx memory c, address custodian, address target, bytes memory data, uint8 a, uint8 b) internal {
        bytes32 message = IHubCustodian(custodian).operationHash(IHubCustodian(custodian).nonce(), target, 0, data);
        IHubCustodian.GroupSignature memory sig = _signWith(c, c.sharesDir, a, b, message);
        vm.broadcast(c.deployerKey);
        IHubCustodian(custodian).execute(target, 0, data, sig);
    }

    /// @dev `_hubExecuteShares` with the default signers {1,3}.
    function _hubExecute(Ctx memory c, address custodian, address target, bytes memory data) internal {
        _hubExecuteShares(c, custodian, target, data, 1, 3);
    }

    /// @dev The adjudicator is not a registered shield caller (no adapterRegistry in this
    /// environment -- E6: no governance), so its payouts pay the pool's live shieldFee like any
    /// other shield.
    function _netOfShieldFee(Ctx memory c, uint256 amount) internal view returns (uint256) {
        uint256 feeBps = c.privacyPool.shieldFee();
        return amount - (amount * feeBps) / 10_000;
    }

    function _fixedPart(
        Ctx memory c,
        address custodian,
        uint64 channelNonce
    ) internal view returns (INitroTypes.FixedPart memory) {
        return ChannelStates.fixedPart(c.user, custodian, channelNonce, c.consensusApp, c.challengeDuration);
    }

    function _state(
        Ctx memory c,
        address custodian,
        uint48 turnNum,
        bool isFinal,
        uint256 userAmount,
        uint256 hubAmount
    ) internal pure returns (INitroTypes.VariablePart memory) {
        return
            ChannelStates.state(address(c.usdc), USER_PAYOUT_NPK, custodian, turnNum, isFinal, userAmount, hubAmount);
    }

    function _readCustodian() internal view returns (address) {
        return vm.parseAddress(vm.readFile(CUSTODIAN_FILE));
    }

    /// @dev Reads deposits.json entry 0 (written by prepare.ts, bound to this script's
    /// custodian via HUB_CUSTODIAN_OVERRIDE).
    function _deposit() internal view returns (Deposit memory d) {
        string memory json = vm.readFile(_depositsPath());
        string memory base = '.deposits[0]';
        d.channelId = vm.parseJsonBytes32(json, string.concat(base, '.channelId'));
        d.channelNonce = uint64(vm.parseJsonUint(json, string.concat(base, '.channelNonce')));
        d.amount = vm.parseJsonUint(json, string.concat(base, '.amount'));
        d.txCalldata = vm.parseJsonBytes(json, string.concat(base, '.calldata'));
    }

    function _depositsPath() internal view returns (string memory) {
        return vm.envOr('DEPOSITS_PATH', string('/env/custodian-e2e/deposits.json'));
    }

    function _manifestPath() internal view returns (string memory) {
        return vm.envOr('MANIFEST_PATH', string('/env/manifest.json'));
    }

    function _ctx() internal view returns (Ctx memory c) {
        string memory manifest = vm.readFile(_manifestPath());
        c.privacyPool = PrivacyPool(payable(vm.parseJsonAddress(manifest, '.armada.pool')));
        c.usdc = IERC20(vm.parseJsonAddress(manifest, '.armada.usdc'));
        c.adjudicator = ArmadaNitroAdjudicator(vm.parseJsonAddress(manifest, '.armadaNitro.adjudicator'));
        c.consensusApp = vm.parseJsonAddress(manifest, '.armadaNitro.consensusApp');
        c.user = vm.parseJsonAddress(manifest, '.testAccounts[0].address');

        string memory keysDir = vm.envOr('KEYS_DIR', string('/env'));
        c.deployerKey = vm.parseUint(vm.readFile(string.concat(keysDir, '/deployer.key')));
        string memory userKeyFile = vm.parseJsonString(manifest, '.testAccounts[0].privateKeyFile');
        c.userKey = vm.parseUint(vm.readFile(string.concat(keysDir, '/', userKeyFile)));

        c.delegateKey = vm.envUint('DELEGATE_KEY');
        c.challengeDuration = uint48(vm.envUint('CHALLENGE_DURATION'));
        c.sharesDir = vm.envOr('SHARES_DIR', string('/env/custodian-shares'));
        c.frostSigner = vm.envOr('FROST_SIGNER', string('frost-signer'));
    }
}
