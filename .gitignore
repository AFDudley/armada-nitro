# Throwaway scratch (per-run build dirs, logs, worktrees): never /tmp
.scratch/

# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs

# Dotenv file
.env

# Local-chain deployment artifacts
/deployments/31337*
# Start blocks that script/WatchtowerScenario.s.sol writes during a run
/deployments/watchtower-e2e-start-block-*

# forge-generated linking helpers
/foundry-pp/

# Python bytecode
__pycache__/
*.pyc

# Lint tooling (package.json devDependencies)
node_modules/

# npm cache written locally by prepare-oracle-env.sh's `npm ci` when a grading
# or dev run's HOME happened to resolve to the repo root instead of a real
# user HOME (arn-46d.1's own worker capture accidentally committed 237 of
# these cache entries; never repo content).
.npm/

# exophial runtime state (config.yaml is tracked)
.pebbles/reducer_ledger.jsonl
.exophial/*
!.exophial/config.yaml
# The commit-boundary gate's build-system declaration (D49.2): tracked so the
# container the judged commit is graded in is built from the judged commit.
!.exophial/gate/
!.exophial/gate/Dockerfile
!.exophial/gate/fetch-submodules.sh
# exophial omp worker settings, written into each worker worktree
.omp-config.yml

# Rust workspace build output
/target

# exophial worker worktrees (the reducer owns them)
.worktrees/
# Run artifacts that script/FixturenetScenario.s.sol writes during a fixturenet run
/deployments/fixturenet-scenario-*

# N4: zk-app circuit build artifacts (reproducible via docs/tasks/N4-zk-forcemove-app.md S2)
test/fixtures/zk-app/trivial/*.ptau
test/fixtures/zk-app/trivial/*.zkey

# G7-deploy (arn-2be): armada-circuits release artifacts, fetched at deploy time by
# lib/armada-poc's scripts/fetch-circuits.sh into this sibling-of-the-submodule path
# (lib/sdk/armada-artifacts.ts's expected layout); never vendored.
/lib/armada-circuits/
