{{ ansible_managed | comment }}
[Unit]
Description=Fixturenet chain data (tmpfs, capped {{ item.item.size | default(fixturenet_tmpfs_default_size) }}) for {{ item.item.path }}
# Order after whatever real filesystem backs the deployment directory, by path
# rather than by a host-specific unit name (a forgotten chain fills this tmpfs
# and dies; the host filesystem is unaffected).
RequiresMountsFor={{ item.item.path | dirname }}

[Mount]
What=tmpfs
Where={{ item.item.path }}
Type=tmpfs
Options=size={{ item.item.size | default(fixturenet_tmpfs_default_size) }},mode={{ item.item.mode | default(fixturenet_tmpfs_default_mode) }}

[Install]
WantedBy=local-fs.target
