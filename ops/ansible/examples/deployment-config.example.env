# laconic-so deployment config for the armada-nitro fixturenet.
# Pass at `deploy init` time with --config-file (NOT --config: cpuset values
# contain commas, and --config splits its argument on commas).
#
#   laconic-so --stack stack/stacks/armada-nitro-fixturenet deploy init \
#     --map-ports-to-host localhost-same \
#     --config-file ops/ansible/examples/deployment-config.example.env \
#     --output ~/deployments/armada-fixturenet/spec.yml
#
# These land in the deployment's config.env and drive docker compose variable
# interpolation (cgroup_parent / cpuset) in
# stack/compose/docker-compose-armada-fixturenet.yml. They MUST match the CPUs
# your ansible fixturenet_slice_allowed_cpus reserves. The values below match
# examples/kelce.yml (slice cores 10-15 + SMT siblings 26-31): geth and the
# beacon get two cores each, one validator per remaining core.

# The reconciler's deployer key (anvil account 0 on the fixturenet).
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Systemd slice the containers run under (must equal ansible fixturenet_slice_name).
FIXTURENET_SLICE=fixturenet.slice

# Per-service cpusets, drawn from the reserved cores.
GETH_CPUSET=10,26
BEACON_CPUSET=11,27
VALIDATOR_0_CPUSET=12
VALIDATOR_1_CPUSET=13
VALIDATOR_2_CPUSET=14
VALIDATOR_3_CPUSET=15
