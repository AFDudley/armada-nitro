pragma solidity ^0.8.37;

import {Test} from 'forge-std/Test.sol';
import {FROST} from 'frost-secp256k1-evm/FROST.sol';

/// @dev The fixture is generated by tools/frost-signer itself: `cargo run --manifest-path
/// tools/frost-signer/Cargo.toml --example gen_forge_fixture -- test/fixtures/frost-signer-fixture.json`
/// runs the tool's own keygen and sign logic (trusted-dealer 2-of-3 keygen, then both FROST rounds
/// for each share pair) and writes the group key plus each pair's (R, z) signature over a fixed
/// 32-byte message. These tests confirm the exact verifier HubCustodian.execute calls —
/// `FROST.verifySignature` — accepts every pair's signature, and rejects it once the message
/// changes by one byte.
contract FrostSignerTest is Test {
    string internal constant FIXTURE = 'test/fixtures/frost-signer-fixture.json';

    function test_frostSignerSignatureVerifies_pair12() public {
        _assertPairVerifies('pair12');
    }

    function test_frostSignerSignatureVerifies_pair13() public {
        _assertPairVerifies('pair13');
    }

    function test_frostSignerSignatureVerifies_pair23() public {
        _assertPairVerifies('pair23');
    }

    /// @dev Flipping one byte of the signed message after signing must make the same on-chain
    /// verifier HubCustodian uses reject the (unchanged) signature.
    function test_frostSignerSignatureRejectsTamperedMessage() public {
        string memory json = vm.readFile(FIXTURE);
        uint256 groupKeyX = vm.parseJsonUint(json, '.groupKeyX');
        uint256 groupKeyY = vm.parseJsonUint(json, '.groupKeyY');
        uint256 commitmentX = vm.parseJsonUint(json, '.signatures.pair12.commitmentX');
        uint256 commitmentY = vm.parseJsonUint(json, '.signatures.pair12.commitmentY');
        uint256 z = vm.parseJsonUint(json, '.signatures.pair12.z');
        bytes32 message = vm.parseJsonBytes32(json, '.message');
        bytes32 tampered = bytes32(uint256(message) ^ uint256(0xff));

        assertTrue(
            FROST.verifySignature(groupKeyX, groupKeyY, commitmentX, commitmentY, z, message),
            'sanity: the untampered message must still verify'
        );
        assertFalse(
            FROST.verifySignature(groupKeyX, groupKeyY, commitmentX, commitmentY, z, tampered),
            'the verifier must reject the signature once the message changes by one byte'
        );
    }

    function _assertPairVerifies(string memory pairKey) internal {
        string memory json = vm.readFile(FIXTURE);
        uint256 groupKeyX = vm.parseJsonUint(json, '.groupKeyX');
        uint256 groupKeyY = vm.parseJsonUint(json, '.groupKeyY');
        uint256 commitmentX =
            vm.parseJsonUint(json, string.concat('.signatures.', pairKey, '.commitmentX'));
        uint256 commitmentY =
            vm.parseJsonUint(json, string.concat('.signatures.', pairKey, '.commitmentY'));
        uint256 z = vm.parseJsonUint(json, string.concat('.signatures.', pairKey, '.z'));
        bytes32 message = vm.parseJsonBytes32(json, '.message');

        assertTrue(
            FROST.verifySignature(groupKeyX, groupKeyY, commitmentX, commitmentY, z, message),
            string.concat('the on-chain FROST verifier must accept the signature for ', pairKey)
        );
    }
}
