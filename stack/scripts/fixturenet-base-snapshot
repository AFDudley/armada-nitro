#!/usr/bin/env bash
# fixturenet-base-snapshot <deployment-dir>
#
# Snapshot the base layer of a fixturenet deployment for reuse by fixturenet-new.
# The deployment MUST have reconciled ONLY the base target (network + weth, usdc,
# cctp, aave, lido, armada) -- its manifest must name exactly those modules.
#
# The snapshot is EXECUTION-LAYER ONLY (format v2). We do NOT tar the beacon, the
# four validators or the consensus genesis; on restore the consensus genesis is
# regenerated as a shadow fork on the recorded execution head with
# GENESIS_TIMESTAMP=now, so the beacon always starts at slot 0 on geth's head and
# a restore never begins with a slot gap no matter how old the snapshot is. This
# mirrors stack-orchestrator's fixturenet-eth (run-cl.sh + reset_genesis_time.sh),
# which resets the beacon genesis time to now on every fresh start.
#
# Steps: verify the manifest is base-only; halt block production by stopping the
# consensus layer (geth stays up so its head is final); record geth's head block
# as the shadow-fork file; stop geth so its on-disk head equals that block;
# tar+zstd the EL layer (geth data + armada_env + the EL genesis + the head block)
# into ~/deployments/.snapshots/; write an auditable key file; prune every other
# base snapshot (we keep exactly one); and restart the whole chain.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/../.." &>/dev/null && pwd)
# shellcheck source=stack/scripts/fixturenet-base-common.sh
source "${SCRIPT_DIR}/fixturenet-base-common.sh"


# arn-e7a c2: the geth host port is random per deployment, so it is discovered with
# `docker port` (the geth container is named "<cluster-id>-armada-fixturenet-geth-1";
# the cluster-id comes from the deployment's deployment.yml).
get_rpc_url() {
  local ctr line
  local cluster
  cluster=$(awk '/^cluster-id:/{print $2}' "${DEP}/deployment.yml" 2>/dev/null || true)
  if [ -z "${cluster}" ]; then
    echo "fixturenet-base-snapshot: no cluster-id in ${DEP}/deployment.yml" >&2
    return 1
  fi
  ctr="${cluster}-armada-fixturenet-geth-1"
  line=$(docker port "${ctr}" 8545 2>/dev/null || true)
  if [ -z "${line}" ]; then
    echo "fixturenet-base-snapshot: FAILED: no published 8545 for ${ctr}" >&2
    return 1
  fi
  echo "http://$(echo "${line#*->}" | tr -d "[:space:]")"
}

usage() { echo "usage: $0 <deployment-dir>" >&2; exit 2; }
[ $# -eq 1 ] || usage
DEP=$(cd -- "$1" &>/dev/null && pwd) || { echo "no such deployment dir: $1" >&2; exit 1; }
[ -d "${DEP}/data" ] || { echo "not a deployment dir (no data/): ${DEP}" >&2; exit 1; }

require_base_only_manifest "$DEP"

KEY=$(compute_base_key "$REPO_ROOT")
mkdir -p "$SNAP_DIR"
SNAP=$(snap_path "$KEY")
KEYFILE=$(key_path "$KEY")

echo "fixturenet-base-snapshot: deployment=${DEP} key=${KEY}"

# 1. Halt block production: stop the consensus layer only. Post-merge geth needs
#    the beacon to drive forkchoice, so with the CL down it produces no new
#    blocks and its head is final -- but it stays up to answer the head query.
echo "fixturenet-base-snapshot: halting block production (stopping the consensus layer)..."
dc "$DEP" stop $CL_SERVICES

# 2. Record geth's final head block as the shadow-fork file.
RPC_URL=$(get_rpc_url)
echo "fixturenet-base-snapshot: recording geth's head block from ${RPC_URL} ..."
headfile=$(mktemp)
trap 'rm -f "$headfile"' EXIT
capture_head_block "$RPC_URL" > "$headfile"
echo "fixturenet-base-snapshot: head: number=$(jq -r .result.number "$headfile") ($(( $(jq -r .result.number "$headfile") ))) hash=$(jq -r .result.hash "$headfile")"

# 3. Stop geth so its on-disk head equals the block we just recorded, then tar the
#    execution layer plus the head block (as head-block.json at the tar root). tar
#    reads root-owned volume files (sudo); zstd writes as us into .snapshots.
echo "fixturenet-base-snapshot: stopping geth..."
dc "$DEP" stop armada-fixturenet-geth

echo "fixturenet-base-snapshot: writing ${SNAP} ..."
sudo cp "$headfile" "${DEP}/data/${SNAP_HEAD_FILE}"
tmp="${SNAP}.tmp.$$"
# shellcheck disable=SC2086
sudo tar -C "${DEP}/data" -cf - $SNAP_EL_VOLUMES $SNAP_GENESIS_EL_PATHS "$SNAP_HEAD_FILE" \
  | zstd -q -19 -T0 -o "$tmp"
mv -f "$tmp" "$SNAP"
sudo rm -f "${DEP}/data/${SNAP_HEAD_FILE}"

# Auditable key file: the exact inputs the key hashes.
{
  echo "# armada-nitro fixturenet base-layer snapshot (format v2, EL-only)"
  echo "# key:      ${KEY}"
  echo "# snapshot: $(basename "$SNAP")"
  echo "# created:  $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "# source:   ${DEP}"
  echo "# el-head:  number=$(jq -r .result.number "$headfile") hash=$(jq -r .result.hash "$headfile")"
  echo "#"
  echo "# sha256(this file's key-input lines, truncated to 16 hex) == key."
  _base_key_lines "$REPO_ROOT"
} > "$KEYFILE"

# Keep exactly one base snapshot: drop every other base snapshot + key file.
shopt -s nullglob
for f in "${SNAP_DIR}"/armada-fixturenet-base-*.tar.zst "${SNAP_DIR}"/armada-fixturenet-base-*.key; do
  case "$f" in
    "$SNAP"|"$KEYFILE") ;;
    *) echo "fixturenet-base-snapshot: pruning old $(basename "$f")"; rm -f "$f" ;;
  esac
done
shopt -u nullglob

# 4. Restart the whole chain we stopped (fixturenet-new's cold path resumes it for
#    the full reconcile). `start` restarts the stopped containers as they were.
echo "fixturenet-base-snapshot: restarting the chain..."
dc "$DEP" start

size=$(du -h "$SNAP" | cut -f1)
echo "fixturenet-base-snapshot: DONE"
echo "  snapshot: ${SNAP} (${size})"
echo "  key file: ${KEYFILE}"
echo "  key:      ${KEY}"
