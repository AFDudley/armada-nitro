#!/usr/bin/env bash
# fixturenet-new <name>
#
# Bring up a new armada-nitro fixturenet at ~/deployments/<name>, reusing a
# cached base layer (weth, usdc, cctp, aave, lido, armada + the chain) when one
# exists for the current inputs, so only armada_nitro + funding get deployed.
#
# fixturenet-new NEVER builds the base layer itself (arn-46d.1). It checks
# whether a snapshot exists for the computed cache key:
#   warm (snapshot present): restore the snapshot, start, run the full reconcile
#         -- base modules report "present, 0"; armada_nitro + funding deploy.
#   cold (no snapshot):      print the key and the build command
#         (stack/scripts/fixturenet-base-build) and exit non-zero.
#
# The chain lives only in RAM: this script mounts a capped tmpfs over data/
# (size FIXTURENET_DATA_SIZE, default 3G) after `deploy create` and before
# `start`. Nothing mounts it at boot, and the chain services do not restart
# (restart: "no"), so after a host reboot nothing runs and nothing is written to
# disk; stack/scripts/fixturenet-recover brings the fixturenet back. On disk,
# data/ is only an empty mountpoint.
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/../.." &>/dev/null && pwd)
# shellcheck source=stack/scripts/fixturenet-base-common.sh
source "${SCRIPT_DIR}/fixturenet-base-common.sh"

# fixturenet-new never builds the fixturenet base layer itself (arn-46d.1):
# check for a base snapshot FIRST, before resolving laconic-so or building the
# armada-nitro images -- refusing a cold start must not depend on docker, a
# clean image build, or any other expensive/fragile work below.
KEY=$(compute_base_key "$REPO_ROOT")
SNAP=$(snap_path "$KEY")
if [ ! -f "$SNAP" ]; then
  echo "fixturenet-new: COLD: no base snapshot for key=${KEY} (${SNAP})"
  echo "  build the base layer with: stack/scripts/fixturenet-base-build"
  echo "  (fixturenet-new never builds the base layer itself)"
  exit 1
fi
MODE=warm

# Resolve laconic-so from LACONIC_SO, else the PATH copy. The exophial oracle
# grading env exposes it through EXOPHIAL_ORACLE_TOOLCHAIN_BINARIES, and a
# hermetic HOME has no ${HOME}/bin, so this never hardcodes ${HOME}/bin. ~/bin
# is on PATH in normal use, so normal use is unchanged. Fail fast if absent.
LACONIC="${LACONIC_SO:-$(command -v laconic-so || true)}"
if [ -z "$LACONIC" ]; then
  echo "fixturenet-new: laconic-so not found on PATH; set LACONIC_SO or add it to PATH" >&2
  exit 1
fi
STACK="stack/stacks/armada-nitro-fixturenet"
CONFIG="stack/config/deployment-config.example.env"
# arn-e7a c1/c2: the host port is random per deployment (laconic-so
# --map-ports-to-host localhost-fixed-random), so the geth RPC is not fixed and
# is discovered with `docker port` (see resolve_geth_rpc, called by wait_for_blocks).
RPC=

# Jobs name their image as cerc/armada-nitro-{env,foundry}:${ARMADA_IMAGE_TAG}
# (arn-895): the image built from this checkout's committed content (git archive
# HEAD), tagged with HEAD's sha. Build it if missing and export the tag so every
# run-job below resolves to it.
export ARMADA_IMAGE_TAG
ARMADA_IMAGE_TAG=$(git -C "$REPO_ROOT" rev-parse HEAD)
export CERC_CONTAINER_BASE_DIR="${CERC_CONTAINER_BASE_DIR:-${HOME}/src/stack-orchestrator/stack_orchestrator/data/container-build}"
for kind in env foundry; do
  if ! docker image inspect "cerc/armada-nitro-${kind}:${ARMADA_IMAGE_TAG}" >/dev/null 2>&1; then
    echo "fixturenet-new: building cerc/armada-nitro-${kind}:${ARMADA_IMAGE_TAG} ..."
    bash "${REPO_ROOT}/stack/container-build/cerc-armada-nitro-${kind}/build.sh" >/dev/null
  fi
done

usage() { echo "usage: $0 <name>" >&2; exit 2; }
[ $# -eq 1 ] || usage
NAME="$1"
DEP="${HOME}/deployments/${NAME}"
SPEC="${DEP}-spec.yml"

now() { date +%s; }
secs() { local s=$1; printf '%dm%02ds' $((s/60)) $((s%60)); }
# arn-396: before this run creates its deployment, stop + delete-volumes any
# stale same-prefix deployment an earlier run left (e.g. after a SIGKILL), then
# remove its directory. A live process still using a deployment keeps it (c6),
# so only the unused ones are stopped and removed (c2).
cleanup_stale_deployments() {
  local d
  # arn-396 c4: the cleanup guards the deployment path against an empty or unset
  # value (c3), and selects earlier deployments by the exact name prefix (c4) --
  # the shared prefix, never a run id.
  if [ -z "$DEP" ]; then
    echo "fixturenet-new: ${DEP} is empty or unset -- skipping stale-deployment cleanup" >&2
    return 0
  fi
  for d in "${HOME}/deployments/${NAME}"*
  do
    if [ -d "$d" ]; then
      # arn-396 c6: a live process still using a deployment keeps it (fuser finds
      # the pid); an unused deployment is stopped and its directory removed.
      if fuser -s "$d" >/dev/null 2>&1; then
        echo "fixturenet-new: ${d} used by a live process -- not removing it"
        continue
      fi
      # arn-396 c2: stop with volume deletion, then remove the deployment directory.
      if [ -e "$d/spec.yml" ]; then
        "$LACONIC" deployment --dir "$d" stop --delete-volumes  # laconic-so deployment stop --delete-volumes
      fi
      # a SIGKILLed prior run can leave the RAM-disk tmpfs still mounted over
      # the data dir, making `rm -rf` fail with "device or resource busy";
      # unmount before removing the deployment directory.
      if [ -d "$d/data" ]; then
        sudo umount "$d/data" 2>/dev/null || true
      fi
      rm -rf "$d"
    fi
  done
}


# Block until geth produces at least one new block (proves live block
# production for both a fresh chain and a restored one), or time out.
# Discover this deployment's geth RPC. The host port is random per deployment
# (arn-e7a c1/c2), so it is found with `docker port` against the geth container
# (named "<cluster-id>-armada-fixturenet-geth-1", cluster-id from deployment.yml).
# The job itself reaches geth by the compose service name (c4), not the host port;
# the host port here is only for this script's own block-production check.
resolve_geth_rpc() {
  local cluster ctr line
  cluster=$(awk '/^cluster-id:/{print $2}' "${DEP}/deployment.yml" 2>/dev/null || true)
  if [ -z "${cluster}" ]; then
    echo "fixturenet-new: no cluster-id in ${DEP}/deployment.yml" >&2
    return 1
  fi
  ctr="${cluster}-armada-fixturenet-geth-1"
  line=$(docker port "${ctr}" 8545 2>/dev/null || true)
  if [ -z "${line}" ]; then
    echo "fixturenet-new: FAILED: no published 8545 for ${ctr}" >&2
    return 1
  fi
  RPC="http://$(echo "${line#*->}" | tr -d "[:space:]")"
  echo "fixturenet-new: geth RPC = ${RPC} (docker port)"
  return 0
}

wait_for_blocks() {
  local deadline=$(( $(now) + 180 )) b0 b1
  # Discover the random host port with `docker port` (arn-e7a c2).
  if ! resolve_geth_rpc; then
    return 1
  fi
  b0=""
  while [ "$(now)" -lt "$deadline" ]; do
    b1=$(curl -s --max-time 3 -H 'Content-Type: application/json' \
           --data '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber","params":[]}' \
           "$RPC" 2>/dev/null | jq -r '.result // empty' 2>/dev/null || true)
    if [ -n "$b1" ]; then
      if [ -z "$b0" ]; then b0="$b1"
      elif [ "$b1" != "$b0" ]; then
        echo "fixturenet-new: blocks advancing ($((b0)) -> $((b1)))"
        return 0
      fi
    fi
    sleep 2
  done
  echo "fixturenet-new: FAILED: no new block within 180s (last=${b1:-none})" >&2
  return 1
}

# Runs the armada-frost-keygen job (arn-1be) instead of the host-side FROST keygen
# + sudo cp that 8f59884 added (install_group_key). The job keygens the 2-of-3 FROST
# group (default seed) into the deployment's state dir (/env), where the full target's
# armada_nitro module reads the group key, so the full reconcile can deploy the custodian.
run_frost_keygen() {
  echo "fixturenet-new: generating the 2-of-3 FROST group key via the job ..."
  "$LACONIC" deployment --dir "$DEP" run-job armada-frost-keygen
}

run_reconcile() {  # run_reconcile <label> [RECONCILER_TARGET-in-container]
  local label="$1" target="${2:-}"
  mkdir -p "${REPO_ROOT}/.scratch"
  local log="${REPO_ROOT}/.scratch/fixturenet-new-${NAME}-${label}.log"
  echo "fixturenet-new: ${label} reconcile ..."
  if [ -n "$target" ]; then
    RECONCILER_TARGET="$target" "$LACONIC" deployment --dir "$DEP" \
      run-job armada-env-reconcile 2>&1 | tee "$log"
  else
    "$LACONIC" deployment --dir "$DEP" run-job armada-env-reconcile 2>&1 | tee "$log"
  fi
  echo "fixturenet-new: ${label} reconcile module results:"
  grep -E '^(weth|usdc|cctp|aave|lido|armada|armada_nitro|funding), ' "$log" | sed 's/^/    /' || true
}

# arn-46d.4: after the full reconcile, the manifest must hold exactly the
# eight expected modules (weth, usdc, cctp, aave, lido, armada, armada_nitro,
# funding); a ninth module or a missing module makes the script fail.
check_module_set() {  # check_module_set <manifest>
  local manifest="$1"
  local expected='["weth","usdc","cctp","aave","lido","armada","armada_nitro","funding"]'
  local actual missing extra
  # Read .gasUsed keys; the real manifest lives under a root-owned
  # tmpfs (needs sudo); a plain temp file (probe) is read without it.
  actual=$(jq -c '.gasUsed | keys' "$manifest" 2>/dev/null || true)
  if [ -z "$actual" ]; then
    actual=$(sudo jq -c '.gasUsed | keys' "$manifest" 2>/dev/null || true)
  fi
  if [ -z "$actual" ]; then
    echo "fixturenet-new: module check FAILED: could not read .gasUsed keys from ${manifest}" >&2
    return 1
  fi
  missing=$(jq -cn --argjson exp "$expected" --argjson act "$actual" '$exp - $act')
  extra=$(jq -cn --argjson exp "$expected" --argjson act "$actual" '$act - $exp')
  if [ -z "$missing" ] || [ -z "$extra" ]; then
    echo "fixturenet-new: module check FAILED: could not compute the set difference" >&2
    return 1
  fi
  if [ "$missing" != '[]' ] || [ "$extra" != '[]' ]; then
    echo "fixturenet-new: module check FAILED: ${manifest} does not hold exactly the eight modules" >&2
    if [ "$missing" != '[]' ]; then
      echo "  missing (expected but absent): $(jq -r '.[]' <<< "$missing")" >&2
    fi
    if [ "$extra" != '[]' ]; then
      echo "  unexpected (present but not expected): $(jq -r '.[]' <<< "$extra")" >&2
    fi
    return 1
  fi
  return 0
}


t0=$(now)
echo "=============================================================="
echo "fixturenet-new: name=${NAME} key=${KEY} mode=${MODE}"
echo "  snapshot: ${SNAP} (present -> RESTORE)"
echo "=============================================================="

# arn-396: remove stale same-prefix deployments an earlier run left behind
# before this run creates its own deployment.
cleanup_stale_deployments

# --- init + create (skipped on a resume where the dir already exists) --------
if [ ! -e "$DEP" ]; then
  echo "fixturenet-new: deploy init + create ${DEP}"
  "$LACONIC" --stack "$STACK" deploy init \
    --map-ports-to-host localhost-fixed-random \
    --config-file "${REPO_ROOT}/${CONFIG}" \
    --output "$SPEC"
  "$LACONIC" --stack "$STACK" deploy create \
    --spec-file "$SPEC" --deployment-dir "$DEP"
else
  echo "fixturenet-new: ${DEP} exists -- resuming (skipping init/create)"
fi

# --- the RAM disk over data/ (owned by this script) --------------------------
# `deploy create` leaves empty per-volume directories under data/ on disk. Remove
# them, so data/ on disk is a bare mountpoint, then mount the tmpfs. Refuse if
# data/ on disk holds any file: chain data must never live on disk.
DATA_SIZE="${FIXTURENET_DATA_SIZE:-3G}"
data_fs() { stat -f -c %T "${DEP}/data"; }
if [ "$(data_fs)" != tmpfs ]; then
  if sudo find "${DEP}/data" -mindepth 1 -not -type d -print -quit | grep -q .; then
    echo "fixturenet-new: ${DEP}/data on disk holds files -- refusing to mount the RAM disk over them" >&2
    exit 1
  fi
  sudo find "${DEP}/data" -mindepth 1 -depth -type d -empty -delete
  sudo mount -t tmpfs -o "size=${DATA_SIZE},mode=0700" tmpfs "${DEP}/data"
fi
if [ "$(data_fs)" != tmpfs ]; then
  echo "fixturenet-new: ${DEP}/data is $(data_fs), not a tmpfs, after mounting" >&2
  exit 1
fi
echo "fixturenet-new: RAM disk OK: ${DEP}/data is a tmpfs, $(df -h --output=size "${DEP}/data" | tail -1 | tr -d ' ')"

# Restore the EL-only base snapshot (every reachable MODE here is "warm": the
# cold case already exited above), then run only armada_nitro + funding.
# restore_snapshot puts geth's data + armada_env + the EL genesis back and hands
# the recorded head to the genesis container's shadow-fork step; `start` then
# regenerates the consensus genesis (slot 0 on geth's head, genesis time = now)
# so the beacon + validators come up fresh with no slot gap. -------------------
# arn-46d.3: before accepting the restore, compare the snapshot's recorded .key
# lines against the current stack/scripts/base-key.py output, and refuse the restore
# on any difference (naming the differing lines). A matching snapshot (recorded
# lines equal the fresh output) is restored as before.
KEYFILE=$(key_path "$KEY")
if ! check_restore_key_diff "$REPO_ROOT" "$KEYFILE"; then
  echo "fixturenet-new: restore REFUSED: recorded key lines differ from the fresh base-key.py output (differing lines named above)" >&2
  exit 1
fi
echo "fixturenet-new: recorded .key lines compared against a fresh base-key.py run; snapshot accepted for restore"
echo "fixturenet-new: restoring ${SNAP} into ${DEP}/data (EL-only; CL genesis regenerated with a shadow fork) ..."
tr=$(now)
restore_snapshot "$DEP" "$SNAP"
echo "fixturenet-new: restore took $(secs $(($(now)-tr)))"
"$LACONIC" deployment --dir "$DEP" start
wait_for_blocks
tf=$(now)
run_frost_keygen
run_reconcile full
echo "fixturenet-new: full reconcile took $(secs $(($(now)-tf)))"


# arn-46d.4: after the full reconcile, verify the manifest holds exactly the eight
# expected modules; fail the script on a ninth or a missing module.
if check_module_set "${DEP}/data/armada_env/manifest.json"; then
  : # pass -- the module set is exactly the eight expected modules
else
  echo "fixturenet-new: manifest module set check failed" >&2
  exit 1
fi

echo "=============================================================="
echo "fixturenet-new: DONE name=${NAME} mode=${MODE} key=${KEY}"
echo "  total wall time: $(secs $(($(now)-t0)))"
echo "  manifest modules: $(sudo jq -r '.gasUsed | keys | join(", ")' "${DEP}/data/armada_env/manifest.json")"
echo "=============================================================="
