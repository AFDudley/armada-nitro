#!/usr/bin/env bash
# fixturenet-recover <name>
#
# Bring the fixturenet at ~/deployments/<name> back after its chain is gone, for
# example after a host reboot.
#
# The chain lives only in a RAM disk over data/ that fixturenet-new mounts
# (stack/README.md, "Chain data lives in RAM, capped"). A reboot removes the RAM
# disk and the chain with it. The chain services do not restart (restart: "no"),
# so after a reboot nothing runs and data/ on disk is a bare mountpoint.
#
# This script:
#   1. refuses while a chain is live: data/ is a tmpfs that holds the chain's EL
#      genesis file;
#   2. stops the deployment, which removes the stopped containers and their
#      network and keeps the deployment config;
#   3. runs fixturenet-new on the existing deployment dir. fixturenet-new mounts
#      the RAM disk (it refuses if data/ on disk holds files) and restores the base
#      snapshot for the current inputs (warm path), or builds and snapshots the
#      base layer when none matches (cold path, about 25 min).
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
# Resolve laconic-so from LACONIC_SO, else the PATH copy; never hardcode
# ${HOME}/bin (a hermetic HOME lacks it). ~/bin is on PATH in normal use.
LACONIC="${LACONIC_SO:-$(command -v laconic-so || true)}"
if [ -z "$LACONIC" ]; then
  echo "fixturenet-recover: laconic-so not found on PATH; set LACONIC_SO or add it to PATH" >&2
  exit 1
fi

usage() { echo "usage: $0 <name>" >&2; exit 2; }
[ $# -eq 1 ] || usage
NAME="$1"
DEP="${HOME}/deployments/${NAME}"
GENESIS="${DEP}/data/armada_fixturenet_genesis/metadata/genesis.json"

[ -d "$DEP" ] || { echo "fixturenet-recover: no deployment at ${DEP}" >&2; exit 1; }
# data/ is root-only (mode 0700), so test the genesis file through sudo.
if [ "$(stat -f -c %T "${DEP}/data")" = tmpfs ] && sudo test -e "$GENESIS"; then
  echo "fixturenet-recover: ${DEP}/data is a RAM disk with a chain in it -- refusing to recover over a live chain" >&2
  exit 1
fi

echo "fixturenet-recover: ${NAME}: no live chain; stopping the deployment"
"$LACONIC" deployment --dir "$DEP" stop
exec "${SCRIPT_DIR}/fixturenet-new" "$NAME"
