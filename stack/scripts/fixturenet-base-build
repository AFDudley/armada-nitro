#!/usr/bin/env bash
# fixturenet-base-build <name>
#
# The ONLY command that builds the fixturenet base layer and writes the base
# snapshot plus its auditable .key file (stack/scripts/fixturenet-base-build).
# fixturenet-new refuses to build the base layer itself; when no snapshot exists
# for the current base-key.py key it exits non-zero and tells you to run this.
#
# No gate job, compose job or worker script calls it -- enforced by a pre-commit
# check (scripts/... gate-no-host-deployment-access / job-no-host-deployment-path)
# so this command is reached only by hand.
#
# Steps (mirroring the cold path fixturenet-new used to run inline):
#   1. ensure the deployment exists (deploy init + create if missing);
#   2. mount the RAM disk over data/ (refuse if data/ on disk holds files);
#   3. start the deployment and wait for at least one new block;
#   4. install the committed base target into the armada_env volume;
#   5. run the base reconcile (armada-env-reconcile with RECONCILER_TARGET);
#   6. run fixturenet-base-snapshot, which halts block production, records geth's
#      head, and writes the snapshot + .key file (the auditable key input lines).
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
REPO_ROOT=$(cd -- "${SCRIPT_DIR}/../.." &>/dev/null && pwd)
# shellcheck source=stack/scripts/fixturenet-base-common.sh
source "${SCRIPT_DIR}/fixturenet-base-common.sh"

usage() { echo "usage: $0 <name>" >&2; exit 2; }
[ $# -eq 1 ] || usage
NAME="$1"
DEP="${HOME}/deployments/${NAME}"
SPEC="${DEP}-spec.yml"

# Resolve laconic-so from LACONIC_SO, else the PATH copy. A hermetic HOME has no
# ${HOME}/bin, so never hardcode it; ~/bin is on PATH in normal use.
LACONIC="${LACONIC_SO:-$(command -v laconic-so || true)}"
if [ -z "$LACONIC" ]; then
  echo "fixturenet-base-build: laconic-so not found on PATH; set LACONIC_SO or add it to PATH" >&2
  exit 1
fi

STACK="stack/stacks/armada-nitro-fixturenet"
CONFIG="stack/config/deployment-config.example.env"
DATA_SIZE="${FIXTURENET_DATA_SIZE:-3G}"
RPC=""

# Jobs name their image as cerc/armada-nitro-{env,foundry}:${ARMADA_IMAGE_TAG}
# (arn-895): the image built from this checkout's committed content (git archive
# HEAD), tagged with HEAD's sha. Build it if missing and export the tag so every
# run-job below resolves to it. Dropped during the extraction from fixturenet-new's
# cold path -- the armada-env-reconcile job's own compose file interpolates
# ${ARMADA_IMAGE_TAG} into its image reference, so running without this left
# ARMADA_IMAGE_TAG unset, defaulting to blank, and docker rejected the resulting
# "cerc/armada-nitro-env:" reference as malformed.
export ARMADA_IMAGE_TAG
ARMADA_IMAGE_TAG=$(git -C "$REPO_ROOT" rev-parse HEAD)
export CERC_CONTAINER_BASE_DIR="${CERC_CONTAINER_BASE_DIR:-${HOME}/src/stack-orchestrator/stack_orchestrator/data/container-build}"
for kind in env foundry; do
  if ! docker image inspect "cerc/armada-nitro-${kind}:${ARMADA_IMAGE_TAG}" >/dev/null 2>&1; then
    echo "fixturenet-base-build: building cerc/armada-nitro-${kind}:${ARMADA_IMAGE_TAG} ..."
    bash "${REPO_ROOT}/stack/container-build/cerc-armada-nitro-${kind}/build.sh" >/dev/null
  fi
done

now() { date +%s; }
secs() { local s=$1; printf '%dm%02ds' $((s/60)) $((s%60)); }

# Discover this deployment's geth RPC. The host port is random per deployment
# (localhost-fixed-random), so it is found with `docker port` against the geth
# container (named "<cluster-id>-armada-fixturenet-geth-1").
resolve_geth_rpc() {
  local cluster ctr line
  cluster=$(awk '/^cluster-id:/{print $2}' "${DEP}/deployment.yml" 2>/dev/null || true)
  if [ -z "${cluster}" ]; then
    echo "fixturenet-base-build: no cluster-id in ${DEP}/deployment.yml" >&2
    return 1
  fi
  ctr="${cluster}-armada-fixturenet-geth-1"
  line=$(docker port "${ctr}" 8545 2>/dev/null || true)
  if [ -z "${line}" ]; then
    echo "fixturenet-base-build: FAILED: no published 8545 for ${ctr}" >&2
    return 1
  fi
  RPC="http://$(echo "${line#*->}" | tr -d "[:space:]")"
  echo "fixturenet-base-build: geth RPC = ${RPC} (docker port)"
  return 0
}

# Block until geth produces at least one new block, or time out.
wait_for_blocks() {
  local deadline=$(( $(now) + 180 )) b0 b1
  if ! resolve_geth_rpc; then
    return 1
  fi
  b0=""
  while [ "$(now)" -lt "$deadline" ]; do
    b1=$(curl -s --max-time 3 -H 'Content-Type: application/json' \
           --data '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber","params":[]}' \
           "$RPC" 2>/dev/null | jq -r '.result // empty' 2>/dev/null || true)
    if [ -n "$b1" ]; then
      if [ -z "$b0" ]; then b0="$b1"
      elif [ "$b1" != "$b0" ]; then
        echo "fixturenet-base-build: blocks advancing ($((b0)) -> $((b1)))"
        return 0
      fi
    fi
    sleep 2
  done
  echo "fixturenet-base-build: FAILED: no new block within 180s (last=${b1:-none})" >&2
  return 1
}

# Run the base reconcile, tee its output to a log, and report the per-module
# results the reconciler prints (the same shape fixturenet-new's run_reconcile
# uses for the cold path).
run_base_reconcile() {
  mkdir -p "${REPO_ROOT}/.scratch"
  local log="${REPO_ROOT}/.scratch/fixturenet-base-build-${NAME}-base.log"
  echo "fixturenet-base-build: base reconcile ..."
  RECONCILER_TARGET="/env/${BASE_TARGET_IN_ENV}" "$LACONIC" deployment --dir "$DEP" \
    run-job armada-env-reconcile 2>&1 | tee "$log"
  echo "fixturenet-base-build: base reconcile module results:"
  grep -E '^(weth|usdc|cctp|aave|lido|armada|armada_nitro|funding), ' "$log" | sed 's/^/    /' || true
}

# 1. Ensure the deployment exists (init + create if missing).
if [ ! -e "$DEP" ]; then
  echo "fixturenet-base-build: deploy init + create ${DEP}"
  "$LACONIC" --stack "$STACK" deploy init \
    --map-ports-to-host localhost-fixed-random \
    --config-file "${REPO_ROOT}/${CONFIG}" \
    --output "$SPEC"
  "$LACONIC" --stack "$STACK" deploy create \
    --spec-file "$SPEC" --deployment-dir "$DEP"
else
  echo "fixturenet-base-build: ${DEP} exists -- resuming (skipping init/create)"
fi

# 2. Mount the RAM disk over data/ (refuse if data/ on disk holds files).
data_fs() { stat -f -c %T "${DEP}/data"; }
if [ "$(data_fs)" != tmpfs ]; then
  if sudo find "${DEP}/data" -mindepth 1 -not -type d -print -quit | grep -q .; then
    echo "fixturenet-base-build: ${DEP}/data on disk holds files -- refusing to mount the RAM disk over them" >&2
    exit 1
  fi
  sudo find "${DEP}/data" -mindepth 1 -depth -type d -empty -delete
  sudo mount -t tmpfs -o "size=${DATA_SIZE},mode=0700" tmpfs "${DEP}/data"
fi
if [ "$(data_fs)" != tmpfs ]; then
  echo "fixturenet-base-build: ${DEP}/data is $(data_fs), not a tmpfs, after mounting" >&2
  exit 1
fi
echo "fixturenet-base-build: RAM disk OK: ${DEP}/data is a tmpfs, $(df -h --output=size "${DEP}/data" | tail -1 | tr -d ' ')"

# 3. Start the deployment, create the volume dirs, wait for at least one new block.
echo "fixturenet-base-build: starting ${DEP} ..."
for v in armada_env $SNAP_ALL_VOLUMES; do sudo mkdir -p "${DEP}/data/${v}"; done
"$LACONIC" deployment --dir "$DEP" start
wait_for_blocks

# 4. Install the committed base target into the armada_env volume (seen as /env).
echo "fixturenet-base-build: installing base target into ${DEP}/data/armada_env"
sudo cp "${REPO_ROOT}/env/targets/fixturenet-base.json" \
        "${DEP}/data/armada_env/${BASE_TARGET_IN_ENV}"

# 5. Run the base reconcile (armada-env-reconcile with RECONCILER_TARGET).
tb=$(now)
run_base_reconcile
echo "fixturenet-base-build: base reconcile took $(secs $(($(now)-tb)))"

# 6. Snapshot the base layer: fixturenet-base-snapshot halts block production,
#    records geth's head, and writes the snapshot + .key file.
echo "fixturenet-base-build: snapshotting the base layer ..."
ts=$(now)
"${SCRIPT_DIR}/fixturenet-base-snapshot" "$DEP"
echo "fixturenet-base-build: base build took $(secs $(($(now)-ts)))"

KEY=$(compute_base_key "$REPO_ROOT")
echo "fixturenet-base-build: DONE"
echo "  key:      ${KEY}"
echo "  snapshot: $(snap_path "${KEY}")"
echo "  key file: $(key_path "${KEY}")"
