#!/usr/bin/env bash
# Jobs for the nitro-railgun local stack.
#   deploy    Armada's PrivacyPool (testing mode) + mock USDC, then the adjudicator and a hub custodian
#   scenario  cooperative close, then a force-close that waits out the challenge window, then verify
set -euo pipefail

RPC="${CERC_ETH_RPC_ENDPOINT:-http://nitro-railgun-anvil:8545}"
# anvil's published development accounts 0-2 and a fixed FROST group scalar: local chain only.
export DEPLOYER_KEY="${DEPLOYER_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80}"
export USER_KEY="${USER_KEY:-0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d}"
export DELEGATE_KEY="${DELEGATE_KEY:-0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a}"
export HUB_GROUP_SCALAR="${HUB_GROUP_SCALAR:-0xa4ddf31f7f32ba696f14ce50ecf3f21e3e100e83bdf47966e7b07468e9500b6e}"
export CHALLENGE_DURATION="${CHALLENGE_DURATION:-15}"
export HUB_REVOCATION_DELAY="${HUB_REVOCATION_DELAY:-60}"

cd /app
until cast block-number --rpc-url "$RPC" >/dev/null 2>&1; do
  echo "waiting for $RPC"
  sleep 1
done

run_script() {
  forge script "$@" --rpc-url "$RPC" --slow
}

json_address() {
  grep -o "\"$2\": *\"0x[0-9a-fA-F]*\"" "$1" | grep -o '0x[0-9a-fA-F]*'
}

case "${1:-}" in
  deploy)
    run_script script/LocalArmada.s.sol --broadcast
    group_key=$(cast wallet public-key --raw-private-key "$HUB_GROUP_SCALAR")
    ARMADA_POOL=$(json_address deployments/31337-armada.json pool) \
    HUB_GROUP_KEY_X="0x${group_key:2:64}" \
    HUB_GROUP_KEY_Y="0x${group_key:66:64}" \
      run_script script/Deploy.s.sol --broadcast --private-key "$DEPLOYER_KEY"
    cat deployments/31337-armada.json deployments/31337.json
    ;;
  scenario)
    run_script script/LocalScenario.s.sol --sig 'setUpHub()' --broadcast
    run_script script/LocalScenario.s.sol --sig 'cooperativeClose()' --broadcast
    run_script script/LocalScenario.s.sol --sig 'openAndChallenge()' --broadcast
    echo "waiting out the ${CHALLENGE_DURATION}s challenge window"
    sleep $((CHALLENGE_DURATION + 3))
    run_script script/LocalScenario.s.sol --sig 'settle()' --broadcast
    run_script script/LocalScenario.s.sol --sig 'verify()'
    ;;
  *)
    echo "usage: nitro-railgun-local deploy|scenario" >&2
    exit 64
    ;;
esac
