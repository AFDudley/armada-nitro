# laconic-so deployment config for the armada-nitro fixturenet.
# Pass at `deploy init` time with --config-file (NOT --config: cpuset values
# contain commas, and --config splits its argument on commas).
#
#   laconic-so --stack stack/stacks/armada-nitro-fixturenet deploy init \
#     --map-ports-to-host localhost-fixed-random \
#     --config-file stack/config/deployment-config.example.env \
#     --output ~/deployments/armada-fixturenet/spec.yml
#
# These land in the deployment's config.env and drive docker compose variable
# interpolation (cgroup_parent / cpuset) in
# stack/compose/docker-compose-armada-fixturenet.yml.
#
# CPU PARTITION (IMPORTANT): the host's CPU policy -- which cores the fixturenet
# slice owns and the rule that its containers may only subdivide that half -- is
# NOT set up here anymore. It is owned by laconic-tech-ops `infra/kelce` (the
# `host_cpu_policy` role, applied continuously by ansible-pull). FIXTURENET_SLICE
# below must equal that role's reserved slice, and every *_CPUSET value MUST be a
# subset of the reserved CPUs the role pins to that slice -- i.e. inside
# `host_cpu_policy_reserved_cpus` (10-15,26-31 on kelce). A cpuset outside the
# reserved partition is refused by that repo's drift check
# (infra/kelce/playbooks/kelce-cpu-policy-check.yml). The values below match
# kelce's partition: geth and the beacon get two cores each, one validator per
# remaining core.

# The reconciler's deployer key (anvil account 0 on the fixturenet).
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Systemd slice the containers run under. Must equal the reserved slice the
# laconic-tech-ops host_cpu_policy role manages (host_cpu_policy_reserved_slice).
FIXTURENET_SLICE=fixturenet.slice

# Per-service cpusets, drawn from the reserved cores (host_cpu_policy_reserved_cpus).
GETH_CPUSET=10,26
BEACON_CPUSET=11,27
VALIDATOR_0_CPUSET=12
VALIDATOR_1_CPUSET=13
VALIDATOR_2_CPUSET=14
VALIDATOR_3_CPUSET=15
